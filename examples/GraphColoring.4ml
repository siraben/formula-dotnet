// Graph 3-Coloring
//
// Color the vertices of the Petersen-like graph K4 (complete graph on
// 4 vertices) using three colors (1, 2, 3) such that no two adjacent
// vertices share the same color.
//
// The graph has edges: 0-1, 0-2, 0-3, 1-2, 1-3, 2-3.
// A valid 3-coloring exists (e.g. 1,2,3,1).

domain GraphColoring
{
    Coloring ::= new (v0: Integer, v1: Integer, v2: Integer, v3: Integer).

    // Every vertex gets a color in {1, 2, 3}
    validRange :- c is Coloring,
        c.v0 >= 1, c.v0 <= 3,
        c.v1 >= 1, c.v1 <= 3,
        c.v2 >= 1, c.v2 <= 3,
        c.v3 >= 1, c.v3 <= 3.

    // K4: every pair of vertices is adjacent
    noConflict :- c is Coloring,
        c.v0 != c.v1,
        c.v0 != c.v2,
        c.v0 != c.v3,
        c.v1 != c.v2,
        c.v1 != c.v3,
        c.v2 != c.v3.

    conforms validRange, noConflict.
}

// Since K4 has chromatic number 4, this is UNSAT with 3 colors.
partial model pm3 of GraphColoring
{
    Coloring(a, b, c, d).
}

// Now try a cycle graph C4 (4-cycle): 0-1, 1-2, 2-3, 3-0.
// Chromatic number 2, so 3 colors is easy.

domain CycleColoring
{
    Coloring ::= new (v0: Integer, v1: Integer, v2: Integer, v3: Integer).

    validRange :- c is Coloring,
        c.v0 >= 1, c.v0 <= 3,
        c.v1 >= 1, c.v1 <= 3,
        c.v2 >= 1, c.v2 <= 3,
        c.v3 >= 1, c.v3 <= 3.

    // C4: only adjacent pairs in the cycle
    noConflict :- c is Coloring,
        c.v0 != c.v1,
        c.v1 != c.v2,
        c.v2 != c.v3,
        c.v3 != c.v0.

    conforms validRange, noConflict.
}

partial model pm_cycle of CycleColoring
{
    Coloring(a, b, c, d).
}
